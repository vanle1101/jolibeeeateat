{
    "name": "microsoft-rewards-script",
    "version": "4.0.3",
    "description": "Automatically do tasks for Microsoft Rewards but in TS!",
    "author": "Netsky",
    "license": "GPL-3.0-or-later",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "pre-build": "npm i && rimraf dist && npx patchright install chromium",
        "install:browser": "npx patchright install chromium",
        "build": "rimraf dist && tsc && node ./scripts/main/copyAssets.js",
        "start": "node --no-warnings ./dist/index.js",
        "points-checker": "npm run build && npm --prefix points-checker start",
        "ts-start": "ts-node ./src/index.ts",
        "dev": "ts-node ./src/index.ts -dev",
        "api": "node ./scripts/api/server.js",
        "vps:api": "node ./scripts/api/server.js",
        "dashboard": "npm --prefix ./local-dashboard start",
        "kill-chrome-win": "powershell -Command \"Get-Process | Where-Object { $_.MainModule.FileVersionInfo.FileDescription -eq 'Google Chrome for Testing' } | ForEach-Object { Stop-Process -Id $_.Id -Force }\"",
        "create-docker": "docker build -t microsoft-rewards-script-docker .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "clear-diagnostics": "rimraf diagnostics",
        "clear-sessions": "node ./scripts/main/clearSessions.js",
        "accounts:migrate": "node --no-warnings ./scripts/main/migrateAccountsDb.js",
        "accounts": "node --no-warnings ./scripts/main/accountsDb.js",
        "accounts:import": "node --no-warnings ./scripts/main/accountsDb.js import",
        "queue:schedule": "node --no-warnings ./scripts/main/queueScheduler.js",
        "queue:dry-run": "node --no-warnings ./scripts/main/queueDryRun.js",
        "queue:run": "call \"%npm_node_execpath%\" --no-warnings ./scripts/main/queueRun.js",
        "queue:worker": "node --no-warnings ./scripts/main/queueWorker.js",
        "queue:status": "node --no-warnings ./scripts/main/queueStatus.js",
        "queue:dispatch": "node --no-warnings ./scripts/main/queueStatus.js --dispatch",
        "test:queue": "node --test ./scripts/queue/queue.test.js",
        "test:accounts": "node --test ./scripts/accountImport.test.js ./scripts/accountStore.test.js",
        "test:proxies": "node --test ./scripts/proxyCleanup.test.js",
        "test:proxy-enforcement": "npm run build && node --test ./scripts/proxyEnforcement.test.js",
        "test:proxy-scheduler": "npm run build && node --test ./scripts/proxyScheduler.test.js",
        "proxies:check": "node --no-warnings ./scripts/main/proxyCheck.js",
        "test:rewards": "npm run build && node --test ./scripts/rewardsBootstrap.test.js",
        "open-session": "node ./scripts/main/browserSession.js -email"
    },
    "keywords": [
        "Bing Rewards",
        "Microsoft Rewards",
        "Bot",
        "Script",
        "TypeScript",
        "Playwright"
    ],
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/ms": "^2.1.0",
        "@types/node": "^24.10.1",
        "@types/semver": "^7.7.1",
        "eslint": "^10.4.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.0"
    },
    "dependencies": {
        "bullmq": "^5.80.7",
        "chalk": "^4.1.2",
        "csv-parse": "^6.2.1",
        "fast-xml-parser": "^5.9.3",
        "fingerprint-generator": "^2.1.82",
        "fingerprint-injector": "^2.1.82",
        "ghost-cursor-playwright-port": "^1.4.3",
        "http-proxy-agent": "^9.0.0",
        "https-proxy-agent": "^9.0.0",
        "impit": "^0.14.2",
        "ioredis": "^5.11.1",
        "ms": "^2.1.3",
        "otpauth": "^9.5.1",
        "p-queue": "^9.3.0",
        "patchright": "^1.61.1",
        "semver": "^7.8.1",
        "socks-proxy-agent": "^10.0.0",
        "ts-node": "^10.9.2",
        "zod": "^4.4.3"
    }
}
